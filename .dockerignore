# Patterns match from the build-context root: a bare `__pycache__/` only
# excludes the top-level one, so anything that can sit at any depth needs `**/`.

.venv/
venv/

.env
.env.*
*.pem

.git/
.gitignore

**/__pycache__/
**/*.py[cod]
*.egg-info/
.ruff_cache/
.mypy_cache/
.pytest_cache/
.import_linter_cache/
.coverage

db.sqlite3
media/

# A real receipt photo for the live OCR tests (gitignored).
receipts/tests/fixtures/receipt.*

# Local editor, agent and planning files (untracked or gitignored).
.idea/
.vscode/
.claude/
.agents/
.mcp.json
skills-lock.json
docs/

Dockerfile
.dockerignore
docker-compose.yml

**/*.log
**/.DS_Store
