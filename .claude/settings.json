{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | { read -r f; case \"$f\" in *.py) uv run ruff check --fix \"$f\"; uv run black --quiet \"$f\";; esac; } 2>/dev/null || true",
            "statusMessage": "Formatting with black and ruff..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(curl:*)",
      "WebFetch",
      "WebSearch",
      "Bash(wget:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(git diff:*)",
      "Bash(grep:*)",
      "Bash(find:*)"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(rm -rf *)",
      "Bash(rmdir)"
    ]
  }
}